{
  "type": "commonjs",
  "name": "react-router-scroll-to-top",
  "version": "1.3.0",
  "description": "React component that scrolls to the top of a page when the current location gets changed",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimazuien/react-router-scroll-to-top.git"
  },
  "homepage": "https://github.com/dimazuien/react-router-scroll-to-top#readme",
  "keywords": [
    "react",
    "react router",
    "scroll restoration",
    "scroll",
    "scroll to top"
  ],
  "author": "Dima Zuien",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dimazuien/react-router-scroll-to-top/issues"
  },
  "source": "src/index.ts",
  "main": "lib/index.js",
  "typings": "index.d.ts",
  "files": [
    "lib",
    "index.d.ts"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "build": "webpack",
    "dts": "npm-dts generate -e src/index --tsc=\"-p tsconfig.build.json\"",
    "lint": "eslint --max-warnings=0 --no-warn-ignored --fix",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --pretty --project tsconfig.json",
    "typecheck:watch": "tsc --watch --noEmit --incremental --preserveWatchOutput --pretty --project tsconfig.json"
  },
